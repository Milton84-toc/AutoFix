@model List<RepuestoFila>
@{ ViewData["Title"] = "Inventario"; var editar = User.HasClaim("permiso", Permisos.Inventario); }
<header class="cabecera"><div><p class="kicker">Almacén</p><h1>Inventario de repuestos</h1></div>
@if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Supervisor)) { <a class="boton secundario" href="/movimientos">Ver movimientos</a> }
</header>
@if (editar) { <details class="panel"><summary>Nuevo repuesto</summary>@await Html.PartialAsync("_RepuestoForm", (RepuestoFila?)null, ViewData)</details> }
<section class="panel">
    <div class="tabla"><table><thead><tr><th>Repuesto</th><th>Categoría y marca</th><th>Precio</th><th>Existencias</th><th>Mínimo</th></tr></thead><tbody>
    @foreach (var r in Model)
    {
        <tr><td>
            @if (r.Foto is not null) { <a href="/imagen/@r.Foto"><img class="miniatura" src="/imagen/@r.Foto" alt="Foto de @r.Nombre"></a> }
            <strong>@r.Nombre</strong><small>@r.Codigo · @r.Descripcion</small>
        </td><td>@r.Categoria · @r.Marca</td><td>$@r.Precio.ToString("F2")</td>
        <td><strong>@r.Existencias</strong> @if (r.Existencias <= r.StockMinimo) { <span class="estado e-PendienteAprobacion">Stock bajo</span> }</td><td>@r.StockMinimo</td></tr>
        @if (editar)
        {
            <tr class="fila-acciones"><td colspan="5"><details><summary>Administrar @r.Nombre</summary>
                <partial name="_RepuestoForm" model="r" />
                <form asp-action="FotoRepuesto" asp-route-id="@r.Id" method="post" enctype="multipart/form-data" class="form-grid cols">
                    <label>Fotografía del repuesto <input name="archivo" type="file" accept=".jpg,.jpeg,.png" required></label>
                    <div><button class="secundario">Guardar foto</button></div>
                </form>
                <form asp-action="BorrarRepuesto" asp-route-id="@r.Id" method="post" data-confirmar="¿Eliminar este repuesto?"><button class="peligro">Eliminar repuesto</button></form>
            </details></td></tr>
        }
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="vacio">No hay repuestos registrados.</td></tr> }
    </tbody></table></div>
</section>
@section Scripts { <script src="~/taller.js" asp-append-version="true" defer></script> }
