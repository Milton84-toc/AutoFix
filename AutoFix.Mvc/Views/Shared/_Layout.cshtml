@{
    var url = Context.Request.Path.Value ?? "/";
    var autenticado = User.Identity?.IsAuthenticated == true;
    var cliente = User.IsInRole(Roles.Cliente);
    var mecanico = User.IsInRole(Roles.Mecanico);
    var admin = User.IsInRole(Roles.Admin);
    var supervisor = User.IsInRole(Roles.Supervisor);
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · AutoFix</title>
    <link rel="stylesheet" href="~/css/autofix.css" asp-append-version="true">
</head>
<body class="@(autenticado ? "shell" : "auth")">
@if (autenticado)
{
    <aside class="sidebar">
        <a class="logo" href="/"><span class="marca">AF</span><span>AutoFix<small>Centro de servicio</small></span></a>
        <nav aria-label="Menú principal">
            <a href="/" class="@(url == "/" ? "active" : "")">Inicio</a>
            <a href="/ordenes" class="@(url.StartsWith("/ordenes") ? "active" : "")">@(cliente ? "Mis reparaciones" : "Órdenes")</a>
            @if (!mecanico)
            {
                <a href="/vehiculos" class="@(url == "/vehiculos" ? "active" : "")">@(cliente ? "Mis vehículos" : "Vehículos")</a>
            }
            @if (!cliente && !mecanico)
            {
                <a href="/clientes" class="@(url == "/clientes" ? "active" : "")">Clientes</a>
                <a href="/mecanicos" class="@(url == "/mecanicos" ? "active" : "")">Mecánicos</a>
            }
            @if (!cliente)
            {
                <a href="/inventario" class="@(url == "/inventario" ? "active" : "")">Inventario</a>
            }
            @if (admin || supervisor)
            {
                <a href="/movimientos" class="@(url == "/movimientos" ? "active" : "")">Movimientos</a>
                <a href="/reportes" class="@(url == "/reportes" ? "active" : "")">Reportes</a>
            }
        </nav>
        <div class="cuenta">
            <strong>@User.Identity?.Name</strong>
            <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
            <form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="salir">Cerrar sesión</button></form>
        </div>
    </aside>
}
<main id="contenido">
    @if (TempData["Exito"] is string exito) { <div class="alert ok" role="status">@exito</div> }
    @if (TempData["Error"] is string error) { <div class="alert error" role="alert">@error</div> }
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
